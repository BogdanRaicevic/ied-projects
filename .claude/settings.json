{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:error)",
      "Bash(pnpm test:run)",
      "Bash(pnpm knip)",
      "Bash(pnpm -F * typecheck)",
      "Bash(pnpm -F * lint)",
      "Bash(pnpm -F * lint:error)",
      "Bash(pnpm -F * test:run *)",
      "Bash(pnpm -F * test:run)",
      "Bash(npx biome check *)",
      "Bash(npx biome lint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(pnpm -F mongo-migrator dev*)",
      "Bash(pnpm release*)"
    ]
  }
}
