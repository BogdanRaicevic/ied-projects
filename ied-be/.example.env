# Listmonk nightly sync (blocklist, bounces, spam). Unset = skipped.
# API user role needs subscribers:get_all, lists:get_all and bounces:get
# (without lists:get_all listmonk returns no bounces, silently).
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=

#Feature Flags eatures
FF_RACUNI_V2=false
BACKUP_TO_S3=false  # this is a feature flag, I don't want to backup to S3 in local development
RACUNI_V2_QR_CODE_ENABLED=false

