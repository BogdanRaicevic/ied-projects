{
  "name": "ied-be",
  "version": "1.0.0",
  "description": "READ ME stuff",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production tsx --import ./src/instrument.ts src/server.ts",
    "dev": "cross-env NODE_ENV=development tsx watch --inspect --import ./src/instrument.ts src/server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "biome:format": "npx biome format --write ./src",
    "biome:check": "npx biome check --write ./src",
    "lint": "npx biome lint ./src",
    "lint:error": "npx biome lint --diagnostic-level error ./src",
    "generate:test-data": "tsx tests/utils/generateStaticData.ts"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "^10.1.0",
    "globals": "catalog:",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1116.0",
    "@clerk/express": "^2.1.61",
    "@sentry/node": "^10.72.0",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "csv-parse": "^7.0.2",
    "date-fns": "catalog:",
    "docxtemplater": "^3.69.3",
    "dotenv": "catalog:",
    "es-toolkit": "catalog:",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "ied-shared": "workspace:^",
    "mongoose": "catalog:",
    "node-cache": "^5.1.2",
    "pizzip": "^3.2.0",
    "puppeteer": "^25.8.0",
    "zod": "catalog:"
  }
}